# SOC agent settings for SOC-DATABASE (VM 2)
# Copy to /etc/soc-agent/soc-agent.env (owner root, group soc-agent,
# mode 0640) and fill in the <PLACEHOLDERS>. Never commit the real file.

# --- Where to send events (VM 4, SOC-CORE) ---------------------------
SOC_INGEST_URL=http://<VM4_TS_IP>:8000/api/ingest
# Must match INGEST_TOKEN in VM 4's .env
SOC_INGEST_TOKEN=<INGEST_TOKEN>
# Shown as source_machine on the dashboard (VM 1 uses SOC-NGINX)
SOC_SOURCE_MACHINE=SOC-DATABASE

# --- PostgreSQL --------------------------------------------------------
# libpq keyword format, so special characters in the password need no
# URL-encoding. soc_monitor only has pg_monitor and cannot read company data.
PG_MONITOR_DSN=host=127.0.0.1 port=5432 dbname=techstore user=soc_monitor password=<SOC_MONITOR_PASSWORD>
PG_LOG_GLOB=/var/log/postgresql/soc/soc-*.json
PG_DATA_DIR=/var/lib/postgresql

# Connection events from these users are not forwarded (failed logins
# always are)
SOC_MONITOR_USERS=soc_monitor
# Sessions from any other address raise database_unexpected_client
SOC_ALLOWED_CLIENT_IPS=127.0.0.1,::1,<VM3_TS_IP>

# --- Detection tuning --------------------------------------------------
SOC_SENSITIVE_TABLES=employees,customers,orders
# Rows read from one sensitive table in one interval that count as a
# bulk read
SOC_BULK_READ_ROWS=1000
SOC_RESOURCE_WARN_PERCENT=90
SOC_LOG_CONNECTIONS=true

# --- Timing and housekeeping ------------------------------------------
SOC_METRICS_INTERVAL=30
SOC_LOG_POLL_INTERVAL=2
SOC_STATE_FILE=/var/lib/soc-agent/state.json
SOC_LOG_LEVEL=INFO
# true = print events to the journal instead of sending them (for testing)
SOC_DRY_RUN=false
