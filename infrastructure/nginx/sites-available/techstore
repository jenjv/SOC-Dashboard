server {
    listen 80 default_server;
    listen [::]:80 default_server;

    server_name _;

    access_log /var/log/nginx/techstore_access.log soc_json;
    error_log /var/log/nginx/techstore_error.log;

    location = /health {
        default_type text/plain;
        return 200 "SOC-NGINX is up\n";
    }

    location / {
        return 200 "Nginx is ready for TechStore and Juice Shop\n";
        add_header Content-Type text/plain;
    }
}
